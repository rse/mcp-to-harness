{
    "compilerOptions": {
      "target":            "ES2024",
      "lib":               [ "ES2024" ],
      "module":            "NodeNext",
      "moduleResolution":  "NodeNext",
      "types":             [ "node" ],
      "outDir":            "./dist",
      "rootDir":           ".",
      "strict":            true,
      "resolveJsonModule": true,
      "esModuleInterop":   true,
      "skipLibCheck":      true,
      "declaration":       false,
      "sourceMap":         false
    },
    "include": [
      "mcp-to-harness.ts",
      "mcp-to-harness-common.ts",
      "mcp-to-harness-claude.ts",
      "mcp-to-harness-codex.ts",
      "mcp-to-harness-copilot.ts"
    ],
    "exclude": [ "node_modules", "dist" ]
}
